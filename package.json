{
  "name": "basicplaywrightjs",
  "version": "1.0.0",
  "description": "Playwright UI and API test framework for multiple portals",
  "scripts": {
    "allure:clean": "rm -rf allure-results allure-report",
    "pretest": "npm run allure:clean",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:slow": "SLOWMO=800 playwright test --headed --workers=1",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:api": "playwright test --grep @api",
    "test:mobile": "playwright test --project=mobile-chrome",
    "test:a11y": "playwright test --grep @a11y",
    "test:visual": "playwright test --grep @visual",
    "test:visual:update": "playwright test --grep @visual --update-snapshots",
    "new:portal": "node scripts/newPortal.js",
    "test:report": "playwright show-report",
    "test:saucedemo": "playwright test tests/saucedemo",
    "test:orangehrm": "playwright test tests/orangehrm",
    "test:wikipedia": "playwright test tests/wikipedia",
    "test:bookstoscrape": "playwright test tests/bookstoscrape",
    "test:restfulbooker": "playwright test tests/restfulbooker",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:report": "npm run allure:generate && npm run allure:open",
    "test:allure": "npm test && npm run allure:report"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@faker-js/faker": "^10.4.0",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.2",
    "allure-commandline": "^2.42.0",
    "allure-playwright": "^3.9.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.4.1",
    "eslint-plugin-playwright": "^2.10.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0"
  }
}
