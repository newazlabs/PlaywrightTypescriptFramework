# Copy this file to .env for local overrides:  cp .env.example .env
# Every variable is OPTIONAL — config files fall back to the public demo
# values, so the project runs out of the box with no .env at all.
# In CI, set real secrets as GitHub Actions secrets, never in this file.

# SauceDemo
# SAUCEDEMO_BASE_URL=https://www.saucedemo.com
# SAUCEDEMO_PASSWORD=secret_sauce

# OrangeHRM
# ORANGEHRM_BASE_URL=https://opensource-demo.orangehrmlive.com
# ORANGEHRM_USERNAME=Admin
# ORANGEHRM_PASSWORD=admin123

# Wikipedia
# WIKIPEDIA_BASE_URL=https://www.wikipedia.org

# Books to Scrape
# BOOKSTOSCRAPE_BASE_URL=https://books.toscrape.com

# Restful Booker (API portal)
# RESTFULBOOKER_BASE_URL=https://restful-booker.herokuapp.com
# RESTFULBOOKER_USERNAME=admin
# RESTFULBOOKER_PASSWORD=password123

# Run browsers in slow motion (ms between actions), e.g. SLOWMO=800
# SLOWMO=
